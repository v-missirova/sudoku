#!/usr/bin/env python
# Local, self-contained GDExtension sources; godot-cpp supplies build settings.
env = SConscript("godot-cpp/SConstruct")
env.Append(CPPPATH=["src/"])
library = env.SharedLibrary(
    target="bin/libsudoku." + env["target"] + ".dll",
    source=Glob("src/*.cpp"),
)
Default(library)
