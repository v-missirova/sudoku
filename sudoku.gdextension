[configuration]
entry_symbol = "sudoku_library_init"
compatibility_minimum = "4.7"

[libraries]
windows.debug.x86_64   = "res://cpp/bin/libsudoku.template_debug.dll"
windows.release.x86_64 = "res://cpp/bin/libsudoku.template_release.dll"

[dependencies]
windows.debug.x86_64 = {
    "res://cpp/bin/libgcc_s_seh-1.dll": "",
    "res://cpp/bin/libstdc++-6.dll": "",
    "res://cpp/bin/libwinpthread-1.dll": ""
}
windows.release.x86_64 = {
    "res://cpp/bin/libgcc_s_seh-1.dll": "",
    "res://cpp/bin/libstdc++-6.dll": "",
    "res://cpp/bin/libwinpthread-1.dll": ""
}
